{
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "ignoreCommand": "echo 'Build ignored: rights and release gates not cleared'; exit 0",
  "rewrites": [
    {
      "source": "/observatory",
      "destination": "/index.html"
    },
    {
      "source": "/observatory/:path*",
      "destination": "/index.html"
    }
  ]
}
